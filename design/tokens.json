{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Namma Commute design tokens (W3C DTCG format). Import into Figma with the Tokens Studio plugin, which turns these into Figma variables and styles. Source of truth remains app/globals.css.",
  "color": {
    "$type": "color",
    "light": {
      "ground":  { "$value": "#fbfafc", "$description": "Page background. Near-white with a faint violet bias, tuned to the Purple line rather than a default grey." },
      "surface": { "$value": "#f4f2f7", "$description": "Inset fields and inactive chips." },
      "raised":  { "$value": "#ffffff", "$description": "Reserved for anything that must sit above the ground." },
      "rule":    { "$value": "#e2dee8", "$description": "Hairline divider. Structure comes from rules, not floating cards." },
      "ink":     { "$value": "#1a161f", "$description": "Primary text." },
      "muted":   { "$value": "#635b6e", "$description": "Secondary text, labels, units." },
      "accent":  { "$value": "#8c2877", "$description": "BMRCL Purple line. Primary action and 'in N min'." },
      "onAccent":{ "$value": "#ffffff" },
      "good":    { "$value": "#1f7a4d", "$description": "Semantic, deliberately not the accent hue." },
      "warn":    { "$value": "#8a5a08", "$description": "Short-loop services that terminate early." }
    },
    "dark": {
      "ground":  { "$value": "#141118" },
      "surface": { "$value": "#1d1923" },
      "raised":  { "$value": "#232030" },
      "rule":    { "$value": "#302a38" },
      "ink":     { "$value": "#f2eff5" },
      "muted":   { "$value": "#9b93a6" },
      "accent":  { "$value": "#d07ac0", "$description": "Lifted so it holds on a dark ground." },
      "onAccent":{ "$value": "#1a161f" },
      "good":    { "$value": "#4ec98a" },
      "warn":    { "$value": "#e0ab4a" }
    },
    "line": {
      "$description": "Network line identities. Brand values come from BMRCL's GTFS routes.txt; Green and Yellow are darkened for text contrast on a light ground.",
      "purpleBrand": { "$value": "#8c2877" },
      "greenBrand":  { "$value": "#009933" },
      "yellowBrand": { "$value": "#ffdf00" },
      "light": {
        "purple": { "$value": "#8c2877" },
        "green":  { "$value": "#00752a" },
        "yellow": { "$value": "#b38600" }
      },
      "dark": {
        "purple": { "$value": "#c072b4" },
        "green":  { "$value": "#3cc46a" },
        "yellow": { "$value": "#e8c33a" }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "ui":   { "$value": "Barlow", "$description": "A grotesk drawn from public-signage lettering — the vernacular this app lives in." },
    "data": { "$value": "IBM Plex Mono", "$description": "Every number: times, fares, distances, capacities. A departure board reads in monospace and digits line up." }
  },
  "typography": {
    "$type": "typography",
    "pageTitle":    { "$value": { "fontFamily": "Barlow", "fontSize": "28px", "fontWeight": 700, "lineHeight": "1.1", "letterSpacing": "-0.01em" } },
    "departure":    { "$value": { "fontFamily": "IBM Plex Mono", "fontSize": "40px", "fontWeight": 600, "lineHeight": "1", "letterSpacing": "-0.02em" }, "$description": "The largest element on the page — the number you squint at." },
    "capacity":     { "$value": { "fontFamily": "IBM Plex Mono", "fontSize": "28px", "fontWeight": 600, "lineHeight": "1" } },
    "stationName":  { "$value": { "fontFamily": "Barlow", "fontSize": "17px", "fontWeight": 600, "lineHeight": "1.2" } },
    "body":         { "$value": { "fontFamily": "Barlow", "fontSize": "15px", "fontWeight": 400, "lineHeight": "1.45" } },
    "dataRow":      { "$value": { "fontFamily": "IBM Plex Mono", "fontSize": "13px", "fontWeight": 400, "lineHeight": "1.4" } },
    "eyebrow":      { "$value": { "fontFamily": "Barlow", "fontSize": "11px", "fontWeight": 600, "lineHeight": "1.2", "letterSpacing": "0.08em", "textCase": "uppercase" }, "$description": "Section labels, set like signage." },
    "caption":      { "$value": { "fontFamily": "Barlow", "fontSize": "12px", "fontWeight": 400, "lineHeight": "1.5" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "36px" },
    "sectionGap": { "$value": "36px", "$description": "Between station-page sections." },
    "pageInline": { "$value": "20px" },
    "contentMax": { "$value": "544px", "$description": "34rem. Single column; this is a one-handed, one-column tool." }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "3px" },
    "md": { "$value": "6px", "$description": "Buttons, fields, chips. Deliberately restrained — signage is planar, not pill-shaped." }
  },
  "component": {
    "rail": {
      "$description": "The line rail: a fragment of the metro map, not a decorative accent bar. Structural — colour says which line, the node says where you are standing.",
      "width":       { "$type": "dimension", "$value": "14px" },
      "strokeWidth": { "$type": "dimension", "$value": "3px" },
      "strokeOpacity": { "$type": "number", "$value": 0.35 },
      "nodeSize":    { "$type": "dimension", "$value": "11px" },
      "nodeBorder":  { "$type": "dimension", "$value": "3px" },
      "nodeOffsetY": { "$type": "dimension", "$value": "18px", "$description": "Aligns the node with the first line of the title." }
    },
    "tapTarget": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "Apple HIG minimum. Every interactive element meets it — this is thumb-driven."
    }
  }
}
